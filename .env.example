# FreeDeepseekAPI primary: must be running locally (default port 9655)
PIRATESEEK_FREEDEEPSEEK_BASE_URL=http://127.0.0.1:9655
# Optional; required only if your proxy has PROXY_API_KEY configured
PIRATESEEK_FREEDEEPSEEK_API_KEY=
PIRATESEEK_FREEDEEPSEEK_MODEL=deepseek-chat

# Official DeepSeek fallback (optional, may incur API charges)
# Keep the real key in your shell environment or a local ignored .env file.
DEEPSEEK_API_KEY=
PIRATESEEK_OFFICIAL_BASE_URL=https://api.deepseek.com
PIRATESEEK_OFFICIAL_MODEL=deepseek-chat

PIRATESEEK_HOST=127.0.0.1
PIRATESEEK_PORT=9766
PIRATESEEK_API_KEY=
PIRATESEEK_STATE_DIR=./.pirateseek
PIRATESEEK_MAX_CONCURRENT=4
